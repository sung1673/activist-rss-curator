{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.bside.ai/schemas/relevance-event.schema.json",
  "title": "BSIDE governance-event relevance benchmark sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "sample_id",
    "event_id",
    "article",
    "stratum",
    "linked_document_ids",
    "label",
    "label_source",
    "annotator_id",
    "labeled_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task": { "const": "relevance" },
    "sample_id": { "type": "string", "minLength": 1 },
    "event_id": {
      "description": "Stable human-reviewed governance event ID; the release gate counts unique values.",
      "type": "string",
      "minLength": 1
    },
    "article": { "$ref": "#/$defs/article" },
    "stratum": {
      "description": "official_event requires an explicit official document link; hard negatives are human-confirmed unrelated same-company samples.",
      "enum": ["official_event", "non_governance_hard_negative"]
    },
    "linked_document_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "label": { "enum": ["relevant", "not_relevant"] },
    "label_source": {
      "description": "fixture is structural-test data and is rejected by release-gate mode.",
      "enum": ["human", "adjudicated", "fixture"]
    },
    "annotator_id": { "type": "string", "minLength": 1 },
    "labeled_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "stratum": { "const": "official_event" } } },
      "then": { "properties": { "linked_document_ids": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "stratum": { "const": "non_governance_hard_negative" } } },
      "then": { "properties": { "linked_document_ids": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article_id", "title", "published_at"],
      "properties": {
        "article_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "published_at": { "type": "string", "format": "date-time" },
        "canonical_url": { "type": "string", "format": "uri" },
        "source": { "type": "string" },
        "company_candidates": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "topic_keywords": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
