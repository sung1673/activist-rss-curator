{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.bside.ai/schemas/shadow-comparison-day.schema.json",
  "title": "BSIDE shadow comparison day evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "environment",
    "evidence_source",
    "is_synthetic",
    "collected_at",
    "code_revision",
    "legacy_run",
    "candidate_run",
    "discrepancies_reviewed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "date": {"type": "string", "format": "date"},
    "environment": {"const": "production"},
    "evidence_source": {"type": "string", "minLength": 1},
    "is_synthetic": {"const": false},
    "collected_at": {"type": "string", "format": "date-time"},
    "code_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "legacy_run": {"$ref": "#/$defs/engineRun"},
    "candidate_run": {"$ref": "#/$defs/engineRun"},
    "discrepancies_reviewed": {"type": "boolean"}
  },
  "$defs": {
    "engineRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "events"],
      "properties": {
        "status": {"type": "string", "enum": ["succeeded", "failed"]},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["comparison_key"],
            "properties": {
              "comparison_key": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
