{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.bside.ai/schemas/editorial-ingest-bundle.schema.json",
  "title": "BSIDE governed editorial ingest bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1, "default": 1 },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor" },
      "default": []
    },
    "event_actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/eventActor" },
      "default": []
    },
    "campaigns": {
      "type": "array",
      "items": { "$ref": "#/$defs/campaign" },
      "default": []
    },
    "claim_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimEvidence" },
      "default": []
    },
    "proposal_votes": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposalVote" },
      "default": []
    },
    "commitment_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitmentOutcome" },
      "default": []
    },
    "timeline_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/timelineEntry" },
      "default": []
    }
  },
  "anyOf": [
    { "required": ["actors"], "properties": { "actors": { "minItems": 1 } } },
    { "required": ["event_actors"], "properties": { "event_actors": { "minItems": 1 } } },
    { "required": ["campaigns"], "properties": { "campaigns": { "minItems": 1 } } },
    { "required": ["claim_evidence"], "properties": { "claim_evidence": { "minItems": 1 } } },
    { "required": ["proposal_votes"], "properties": { "proposal_votes": { "minItems": 1 } } },
    { "required": ["commitment_outcomes"], "properties": { "commitment_outcomes": { "minItems": 1 } } },
    { "required": ["timeline_entries"], "properties": { "timeline_entries": { "minItems": 1 } } }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.:\\-]+$"
    },
    "actorId": {
      "allOf": [
        { "$ref": "#/$defs/stableId" },
        { "maxLength": 64 }
      ]
    },
    "companyId": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9_.:\\-]+$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "draft": {
      "type": "string",
      "const": "draft",
      "default": "draft"
    },
    "pending": {
      "type": "string",
      "const": "pending",
      "default": "pending"
    },
    "eventOrCampaign": {
      "anyOf": [
        { "required": ["event_id"] },
        { "required": ["campaign_id"] }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "display_name"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/actorId" },
        "actor_type": {
          "enum": ["company", "activist_shareholder", "institution", "shareholder_coalition", "regulator", "advisor"]
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "display_name_en": { "type": "string", "minLength": 1, "maxLength": 255 },
        "company_id": { "$ref": "#/$defs/companyId" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "aliases": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 },
          "uniqueItems": true,
          "default": []
        },
        "homepage_url": { "type": "string", "minLength": 1 },
        "record_status": { "type": "string", "const": "inactive", "default": "inactive" },
        "review_status": { "$ref": "#/$defs/pending" }
      }
    },
    "eventActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "actor_id", "actor_role"],
      "properties": {
        "event_id": { "$ref": "#/$defs/stableId" },
        "actor_id": { "$ref": "#/$defs/actorId" },
        "actor_role": { "$ref": "#/$defs/code" },
        "review_status": { "$ref": "#/$defs/pending" }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "company_id",
        "lead_actor_id",
        "title",
        "original_language",
        "demand_text",
        "stage",
        "started_at",
        "evidence_document_ids"
      ],
      "properties": {
        "campaign_id": { "$ref": "#/$defs/stableId" },
        "company_id": { "$ref": "#/$defs/companyId" },
        "lead_actor_id": { "$ref": "#/$defs/actorId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 700 },
        "original_language": { "$ref": "#/$defs/language" },
        "demand_text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "stage": {
          "enum": [
            "initial_signal",
            "private_engagement",
            "public_letter",
            "public_campaign",
            "shareholder_proposal",
            "proxy_vote",
            "resolution",
            "implementation_tracking",
            "closed"
          ]
        },
        "outcome": { "enum": ["settled", "withdrawn", "passed", "failed"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "review_status": { "$ref": "#/$defs/pending" },
        "publication_status": { "$ref": "#/$defs/draft" },
        "evidence_document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "event_id",
        "document_id",
        "claim_type",
        "claim_text",
        "original_language"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/stableId" },
        "event_id": { "$ref": "#/$defs/stableId" },
        "campaign_id": { "$ref": "#/$defs/stableId" },
        "actor_id": { "$ref": "#/$defs/actorId" },
        "document_id": { "$ref": "#/$defs/stableId" },
        "claim_type": {
          "enum": [
            "actor_claim",
            "company_response",
            "official_fact",
            "media_report",
            "editorial_interpretation"
          ]
        },
        "claim_text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "original_language": { "$ref": "#/$defs/language" },
        "evidence_locator": { "type": "string", "minLength": 1, "maxLength": 500 },
        "editorial_status": { "$ref": "#/$defs/pending" }
      }
    },
    "proposalVote": {
      "allOf": [
        { "$ref": "#/$defs/eventOrCampaign" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal_vote_id",
            "company_id",
            "agenda_title",
            "original_language",
            "meeting_at",
            "evidence_document_id"
          ],
          "properties": {
            "proposal_vote_id": { "$ref": "#/$defs/stableId" },
            "event_id": { "$ref": "#/$defs/stableId" },
            "campaign_id": { "$ref": "#/$defs/stableId" },
            "company_id": { "$ref": "#/$defs/companyId" },
            "proposer_actor_id": { "$ref": "#/$defs/actorId" },
            "agenda_no": { "type": "string", "minLength": 1, "maxLength": 40 },
            "agenda_title": { "type": "string", "minLength": 1, "maxLength": 700 },
            "original_language": { "$ref": "#/$defs/language" },
            "meeting_at": { "$ref": "#/$defs/timestamp" },
            "recommendation": { "type": "string", "minLength": 1, "maxLength": 40 },
            "recommendation_source": { "type": "string", "minLength": 1, "maxLength": 255 },
            "result": { "enum": ["pending", "passed", "failed", "withdrawn"] },
            "votes_for": { "type": "number", "minimum": 0, "maximum": 100 },
            "votes_against": { "type": "number", "minimum": 0, "maximum": 100 },
            "votes_abstain": { "type": "number", "minimum": 0, "maximum": 100 },
            "evidence_document_id": { "$ref": "#/$defs/stableId" },
            "review_status": { "$ref": "#/$defs/pending" },
            "publication_status": { "$ref": "#/$defs/draft" }
          }
        }
      ]
    },
    "commitmentOutcome": {
      "allOf": [
        { "$ref": "#/$defs/eventOrCampaign" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commitment_id",
            "company_id",
            "commitment_text",
            "original_language",
            "evidence_document_id"
          ],
          "properties": {
            "commitment_id": { "$ref": "#/$defs/stableId" },
            "event_id": { "$ref": "#/$defs/stableId" },
            "campaign_id": { "$ref": "#/$defs/stableId" },
            "company_id": { "$ref": "#/$defs/companyId" },
            "commitment_text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
            "original_language": { "$ref": "#/$defs/language" },
            "target_at": { "$ref": "#/$defs/timestamp" },
            "actual_action": { "type": "string", "minLength": 1, "maxLength": 1000000 },
            "status": { "enum": ["planned", "announced", "in_progress", "met", "partially_met", "missed", "cancelled"] },
            "target_metrics": { "type": "object" },
            "actual_metrics": { "type": "object" },
            "evidence_document_id": { "$ref": "#/$defs/stableId" },
            "review_status": { "$ref": "#/$defs/pending" },
            "publication_status": { "$ref": "#/$defs/draft" }
          }
        }
      ]
    },
    "timelineEntry": {
      "allOf": [
        { "$ref": "#/$defs/eventOrCampaign" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeline_entry_id",
            "document_id",
            "occurred_at",
            "entry_type",
            "title",
            "original_language"
          ],
          "properties": {
            "timeline_entry_id": { "$ref": "#/$defs/stableId" },
            "event_id": { "$ref": "#/$defs/stableId" },
            "campaign_id": { "$ref": "#/$defs/stableId" },
            "document_id": { "$ref": "#/$defs/stableId" },
            "occurred_at": { "$ref": "#/$defs/timestamp" },
            "entry_type": { "$ref": "#/$defs/code" },
            "title": { "type": "string", "minLength": 1, "maxLength": 700 },
            "description": { "type": "string", "minLength": 1, "maxLength": 1000000 },
            "original_language": { "$ref": "#/$defs/language" },
            "review_status": { "$ref": "#/$defs/pending" },
            "publication_status": { "$ref": "#/$defs/draft" }
          }
        }
      ]
    }
  }
}
