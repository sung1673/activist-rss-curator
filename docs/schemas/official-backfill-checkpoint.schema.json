{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.bside.ai/schemas/official-backfill-checkpoint.schema.json",
  "title": "BSIDE official-disclosure backfill checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job",
    "created_at",
    "updated_at",
    "company_master_synced",
    "completed_windows",
    "failed_windows"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range_start",
        "range_end_exclusive",
        "chunk_days",
        "sources",
        "page_count",
        "max_pages",
        "sync_company_master",
        "fingerprint"
      ],
      "properties": {
        "range_start": { "type": "string", "format": "date" },
        "range_end_exclusive": { "type": "string", "format": "date" },
        "chunk_days": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "items": { "enum": ["dart", "kind"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "page_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_pages": { "type": "integer", "minimum": 1 },
        "sync_company_master": { "type": "boolean" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "company_master_synced": { "type": "boolean" },
    "dart_quota_blocked_until": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "completed_windows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/windowResult" }
    },
    "failed_windows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/windowResult" }
    }
  },
  "$defs": {
    "windowResult": {
      "type": "object",
      "required": [
        "window_start",
        "window_end_exclusive",
        "source_end_inclusive",
        "idempotency_key",
        "attempt",
        "code_revision",
        "status",
        "finished_at"
      ],
      "properties": {
        "window_start": { "type": "string", "format": "date" },
        "window_end_exclusive": { "type": "string", "format": "date" },
        "source_end_inclusive": { "type": "string", "format": "date" },
        "idempotency_key": { "type": "string", "pattern": "^official-backfill-v1:[0-9a-f]{32}$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "code_revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "status": { "enum": ["succeeded", "failed"] },
        "finished_at": { "type": "string", "format": "date-time" },
        "summary": {
          "type": "object",
          "properties": {
            "official_remote_failure_details": {
              "type": "array",
              "maxItems": 10002,
              "items": { "$ref": "#/$defs/remoteFailureTelemetry" }
            }
          },
          "additionalProperties": { "type": "integer" }
        },
        "error": { "type": "string" }
      }
    },
    "remoteFailureTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "batch_number",
        "http_status",
        "error_code",
        "response_body_bytes",
        "elapsed_ms",
        "exception_class"
      ],
      "properties": {
        "scope": { "enum": ["data_batch", "company_batch", "final_run"] },
        "batch_number": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "http_status": {
          "anyOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "type": "null" }
          ]
        },
        "error_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "response_body_bytes": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "exception_class": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
            },
            { "type": "null" }
          ]
        },
        "sqlstate_class": {
          "type": "string",
          "pattern": "^[0-9A-Z]{5}$"
        },
        "driver_code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "validation_reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    }
  }
}
