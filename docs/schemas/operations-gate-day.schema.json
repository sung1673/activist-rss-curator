{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.bside.ai/schemas/operations-gate-day.schema.json",
  "title": "BSIDE production operations release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "environment",
    "evidence_source",
    "is_synthetic",
    "collected_at",
    "code_revision",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "date": {"type": "string", "format": "date"},
    "environment": {"const": "production"},
    "evidence_source": {"type": "string", "minLength": 1},
    "is_synthetic": {"const": false},
    "collected_at": {"type": "string", "format": "date-time"},
    "code_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics_contract_version",
        "distribution_mode",
        "official_ingest_success_rate",
        "dart_ingest_success_rate",
        "kind_ingest_success_rate",
        "official_lag_p95_minutes",
        "dart_success_poll_interval_p95_minutes",
        "kind_observation_lag_p95_minutes",
        "content_snapshot_at",
        "content_scope",
        "web_distribution_attempted_count",
        "web_distribution_succeeded_count",
        "web_distribution_success_rate",
        "web_distribution_failure_detection_p95_minutes",
        "telegram_delivery_attempted_count",
        "raw_counts",
        "official_evidence_link_rate",
        "top_sensitive_human_review_rate",
        "original_language_preservation_rate",
        "valid_source_right_rate"
      ],
      "properties": {
        "metrics_contract_version": {"const": 2},
        "distribution_mode": {"const": "web_only"},
        "official_ingest_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "dart_ingest_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "kind_ingest_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "official_lag_p95_minutes": {"type": "number", "minimum": 0},
        "dart_success_poll_interval_p95_minutes": {"type": "number", "minimum": 0},
        "kind_observation_lag_p95_minutes": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "content_snapshot_at": {"type": "string", "format": "date-time"},
        "content_scope": {"const": "governance_corpus_2021_plus_kst_day_end_v2"},
        "web_distribution_attempted_count": {"type": "integer", "minimum": 1},
        "web_distribution_succeeded_count": {"type": "integer", "minimum": 0},
        "web_distribution_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "web_distribution_failure_detection_p95_minutes": {"type": "number", "minimum": 0},
        "telegram_delivery_attempted_count": {"const": 0},
        "raw_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official_ingest_expected_count",
            "official_ingest_succeeded_count",
            "dart_ingest_expected_count",
            "dart_ingest_succeeded_count",
            "kind_ingest_expected_count",
            "kind_ingest_succeeded_count",
            "kind_observation_count",
            "kind_lag_sample_count",
            "official_evidence_total_count",
            "official_evidence_linked_count",
            "top_sensitive_total_count",
            "top_sensitive_reviewed_count",
            "original_language_total_count",
            "original_language_preserved_count",
            "source_right_total_count",
            "valid_source_right_count"
          ],
          "properties": {
            "official_ingest_expected_count": {"type": "integer", "minimum": 1},
            "official_ingest_succeeded_count": {"type": "integer", "minimum": 0},
            "dart_ingest_expected_count": {"type": "integer", "minimum": 1},
            "dart_ingest_succeeded_count": {"type": "integer", "minimum": 0},
            "kind_ingest_expected_count": {"type": "integer", "minimum": 1},
            "kind_ingest_succeeded_count": {"type": "integer", "minimum": 0},
            "kind_observation_count": {"type": "integer", "minimum": 0},
            "kind_lag_sample_count": {"type": "integer", "minimum": 0},
            "official_evidence_total_count": {"type": "integer", "minimum": 0},
            "official_evidence_linked_count": {"type": "integer", "minimum": 0},
            "top_sensitive_total_count": {"type": "integer", "minimum": 0},
            "top_sensitive_reviewed_count": {"type": "integer", "minimum": 0},
            "original_language_total_count": {"type": "integer", "minimum": 0},
            "original_language_preserved_count": {"type": "integer", "minimum": 0},
            "source_right_total_count": {"type": "integer", "minimum": 0},
            "valid_source_right_count": {"type": "integer", "minimum": 0}
          }
        },
        "official_evidence_link_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "top_sensitive_human_review_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "original_language_preservation_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "valid_source_right_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
